# Token de GitHub (lectura de repositorios públicos alcanza): https://github.com/settings/tokens
GITHUB_TOKEN=

# Base de resultados. Con docker compose, HOST y PORT los pone el compose.
POSTGRES_USER=metricas
POSTGRES_PASSWORD=metricas
POSTGRES_DB=tres_p
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Clon propio del repositorio (opcional). Con docker compose: ruta en el host, se monta en /repo
# y en proyecto.json va "clon": "/repo".
# TRES_P_CLON_HOST=/ruta/al/clon
